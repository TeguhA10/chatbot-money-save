apiVersion: v1
kind: Secret
metadata:
  name: chatbot-secrets
  namespace: chatbot-finance
type: Opaque
stringData:
  APP_KEY: "base64:YOUR_APP_KEY_HERE"
  DB_USERNAME: "postgres"
  DB_PASSWORD: "YOUR_STRONG_PASSWORD"
  REDIS_PASSWORD: "YOUR_REDIS_PASSWORD"
  WHATSAPP_PHONE_NUMBER_ID: "YOUR_META_PHONE_NUMBER_ID"
  WHATSAPP_ACCESS_TOKEN: "YOUR_META_PERMANENT_ACCESS_TOKEN"
  WHATSAPP_VERIFY_TOKEN: "YOUR_META_WEBHOOK_VERIFY_TOKEN"
  WHATSAPP_APP_SECRET: "YOUR_META_APP_SECRET"
  GATEWAY_WEBHOOK_SECRET: "YOUR_INTERNAL_GATEWAY_SECRET"
  FINANCE_ENCRYPTION_KEY: "YOUR_FINANCE_ENCRYPTION_KEY_32BYTES"
